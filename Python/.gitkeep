    {
      "cell_type": "code",
      "source": [
        "inventory = inventory.merge(\n",
        "    products[[\"Product_ID\", \"Lead_Time_Days\"]],\n",
        "    on=\"Product_ID\",\n",
        "    how=\"left\"\n",
        ")"
      ],
      "metadata": {
        "id": "OVIO3oPCGu26"
      },
      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "inventory[\"Lead_Time_Demand\"] = (\n",
        "    inventory[\"Avg_Daily_Demand\"] *\n",
        "    inventory[\"Lead_Time_Days\"]\n",
        ").round(2)"
      ],
      "metadata": {
        "id": "0Ag6gMgNHLAR"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "inventory[\"Stockout_Risk\"] = np.where(\n",
        "    inventory[\"Current_Inventory\"] < inventory[\"Lead_Time_Demand\"],\n",
        "    \"High Risk\",\n",
        "    \"Low Risk\"\n",
        ")\n",
        "\n",
        "display(inventory[\n",
        "    [\"Product_Name\", \"Current_Inventory\",\n",
        "     \"Lead_Time_Demand\", \"Stockout_Risk\"]\n",
        "])"
      ],
      "metadata": {
