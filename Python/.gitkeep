          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#demand by category\n",
        "category_demand = (\n",
        "    orders_products\n",
        "    .groupby(\"Category\")[\"Demand_Units\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "print(category_demand)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5LDe5vXmYwYG",
        "outputId": "53a30ce2-523c-44f9-8e31-146c5318096a"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Category\n",
            "Accessories    44555\n",
            "Peripherals    11700\n",
            "Storage         8686\n",
            "Displays        6954\n",
            "Name: Demand_Units, dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Monthly Demand Trend\n",
        "orders[\"Month\"] = orders[\"Date\"].dt.to_period(\"M\").astype(str)\n",
        "\n",
        "monthly_demand = (\n",
        "    orders.groupby(\"Month\")[\"Demand_Units\"]\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "print(monthly_demand)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "HhCuZiyuY14M",
        "outputId": "7935f5a9-420c-4e85-d663-08640328d6e0"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Month\n",
            "2025-01    11871\n",
            "2025-02    11322\n",
            "2025-03    12851\n",
            "2025-04    12343\n",
            "2025-05    12205\n",
            "2025-06    11303\n",
            "Name: Demand_Units, dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "monthly_demand.plot(kind=\"line\", marker=\"o\")\n",
        "\n",
        "plt.title(\"Monthly Demand Trend\")\n",
        "plt.xlabel(\"Month\")\n",
        "plt.ylabel(\"Demand Units\")\n",
