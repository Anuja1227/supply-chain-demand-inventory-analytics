    {
      "cell_type": "code",
      "source": [
        "#monthly product demand\n",
        "monthly_product_demand = (\n",
        "    orders_products\n",
        "    .groupby([\n",
        "        pd.Grouper(key=\"Date\", freq=\"MS\"),\n",
        "        \"Product_ID\",\n",
        "        \"Product_Name\"\n",
        "    ])[\"Demand_Units\"]\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "display(monthly_product_demand.head(10))"
      ],
