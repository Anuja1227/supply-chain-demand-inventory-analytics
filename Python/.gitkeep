      "source": [
        "#find the best permoning suppliers\n",
        "supplier_performance = suppliers.sort_values(\n",
        "    \"On_Time_Delivery_Pct\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "display(\n",
        "    supplier_performance[\n",
        "        [\"Supplier_Name\",\n",
        "         \"On_Time_Delivery_Pct\",\n",
        "         \"Avg_Lead_Time_Days\"]\n",
        "    ]\n",
        ")"
      ],
