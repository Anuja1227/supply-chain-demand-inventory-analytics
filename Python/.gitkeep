    {
      "cell_type": "code",
      "source": [
        "#3-month moving avg\n",
        "mouse = monthly_product_demand[\n",
        "    monthly_product_demand[\"Product_Name\"] == \"Wireless Mouse\"\n",
        "].copy()\n",
        "\n",
        "mouse[\"Forecast\"] = (\n",
        "    mouse[\"Demand_Units\"]\n",
        "    .rolling(window=3)\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "display(mouse)"
      ],
      "metadata": {
