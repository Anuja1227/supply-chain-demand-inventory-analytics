    {
      "cell_type": "code",
      "source": [
        "total_demand = orders[\"Demand_Units\"].sum()\n",
        "total_sales = orders[\"Sales_Value\"].sum()\n",
        "\n",
        "print(\"Total Demand Units:\", total_demand)\n",
        "print(\"Total Sales Value:\", round(total_sales, 2))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "STNdVPpGYdFg",
        "outputId": "98e4bf5c-dd52-4ba0-f617-cbb358765971"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total Demand Units: 71895\n",
            "Total Sales Value: 306879228.68\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "orders_products = orders.merge(\n",
        "    products[[\"Product_ID\", \"Product_Name\", \"Category\"]],\n",
        "    on=\"Product_ID\",\n",
        "    how=\"left\"\n",
        ")"
      ],
      "metadata": {
        "id": "3aZAKZEBYeXY"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#group demand by product\n",
        "product_demand = (\n",
        "    orders_products\n",
        "    .groupby(\"Product_Name\")\n",
        "    [\"Demand_Units\"].sum()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "print(product_demand)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-Uqjur5uYgkO",
        "outputId": "0bc0271c-9b44-4255-fcb7-d0120bf6ac1b"
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Product_Name\n",
            "Power Bank             7557\n",
            "Laptop Stand           7458\n",
