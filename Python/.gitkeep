    {
      "cell_type": "code",
      "source": [
        "#Days Sales of Inventory\n",
        "inventory[\"Days_of_Inventory\"] = (\n",
        "    inventory[\"Current_Inventory\"] /\n",
        "    inventory[\"Avg_Daily_Demand\"]\n",
        ").round(2)\n",
        "\n",
        "display(inventory[\n",
        "    [\"Product_Name\", \"Current_Inventory\",\n",
        "     \"Avg_Daily_Demand\", \"Days_of_Inventory\"]\n",
        "])"
      ],
