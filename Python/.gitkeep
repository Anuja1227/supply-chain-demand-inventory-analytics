    {
      "cell_type": "code",
      "source": [
        "#calculate map to know how good forecast is\n",
        "mouse_accuracy = mouse.dropna(subset=[\"Forecast\"]).copy()\n",
        "\n",
        "mouse_accuracy[\"APE\"] = (\n",
        "    abs(\n",
        "        mouse_accuracy[\"Demand_Units\"]\n",
        "        - mouse_accuracy[\"Forecast\"]\n",
        "    )\n",
        "    / mouse_accuracy[\"Demand_Units\"]\n",
        ") * 100\n",
        "\n",
        "mape = mouse_accuracy[\"APE\"].mean()\n",
        "\n",
        "print(\"Wireless Mouse MAPE:\", round(mape, 2), \"%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rAhNOzWNH6ar",
        "outputId": "44dcc2e6-232f-4c6a-9581-67d9d43ed4bd"
      },
      "execution_count": 28,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Wireless Mouse MAPE: 3.36 %\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "output_file = \"Supply_Chain_Processed_Data.xlsx\"\n",
        "\n",
        "with pd.ExcelWriter(output_file, engine=\"openpyxl\") as writer:\n",
        "\n",
        "    orders_products.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Orders\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    inventory.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Inventory\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    suppliers.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Suppliers\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    products.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Products\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    monthly_product_demand.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Monthly_Demand\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    mouse.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Forecast\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"File created successfully!\")"
      ],
